  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
